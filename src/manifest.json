{
   "background": {
      "service_worker": "service_worker.js",
      "type": "module"
   },
   "default_locale": "en",
   "description": "__MSG_extDescription__",
   "icons": {
      "16": "images/16.png",
      "48": "images/48.png",
      "128": "images/128.png"
   },
   "manifest_version": 3,
   "name": "__MSG_extName__",
